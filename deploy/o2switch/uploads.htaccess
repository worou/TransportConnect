# Photos envoyées par les apps : fichiers image uniquement, aucun script exécuté
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .sh
RemoveType .php .phtml .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?i:jpe?g|png|webp)$">
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>
